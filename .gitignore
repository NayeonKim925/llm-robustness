# Python / Jupyter / tooling
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
*.egg-info/
.DS_Store
